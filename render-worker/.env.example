# Copy these into Replit → Tools → Secrets (never commit real values).

# Shared secret between Supabase edge function and this worker.
# Must match RENDER_SHARED_SECRET stored in Lovable secrets.
RENDER_SHARED_SECRET=change-me-to-a-long-random-hex

# Google Cloud Storage bucket that receives finished MP4 renders.
GCS_BUCKET=automationnova-render-output-2026

# Service account JSON for GCS uploads + signed URLs.
# In Replit: paste the entire JSON (single line) as this secret.
# In server.js, google-cloud/storage picks it up via GOOGLE_APPLICATION_CREDENTIALS.
# On Replit, write it to /tmp/gcp-sa.json at boot (see README).
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", "...": "..."}

# Path to Chromium binary (auto-set by replit.nix — override only if needed).
PUPPETEER_EXECUTABLE_PATH=/nix/store/.../bin/chromium

# Port (Replit assigns 8080 automatically).
PORT=8080